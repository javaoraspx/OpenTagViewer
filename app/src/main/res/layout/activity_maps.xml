<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:map="http://schemas.android.com/apk/res-auto"
    android:id="@+id/map_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:elevation="8dp">

    <FrameLayout
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        tools:context=".MapsActivity" />

    <!-- clipChildren/clipToPadding are both off so the cards' 8dp elevation shadow can draw
         outside the content box. MapsActivity pads the bottom of this view by the navigation
         bar inset, and with the default clipToPadding="true" that padding would slice the
         shadow off along a hard edge. -->
    <HorizontalScrollView
        android:id="@+id/tags_scrollable_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentRight="true"
        android:layout_alignParentBottom="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbarAlwaysDrawHorizontalTrack="false"
        android:scrollbarAlwaysDrawVerticalTrack="false"
        android:scrollbars="none"
        tools:visibility="gone">

        <LinearLayout
            android:id="@+id/tags_scroll_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:paddingStart="@dimen/map_edge_margin"
            android:paddingEnd="@dimen/map_edge_margin" />
    </HorizontalScrollView>

    <!-- The top margins here and on long_fetch_banner are the gap below the status bar, not the
         distance from the top of the screen: MapsActivity adds the bar's real height through
         WindowPaddingUtil.insertUITopMargin. They used to be fixed at 35dp and 45dp, which put the
         button under a taller status bar, where a tap opened the notification shade (#286). The
         values give the same position as before on a 24dp status bar. -->
    <LinearLayout
        android:id="@+id/more_dropdown_top_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"
        android:layout_marginTop="11dp"
        android:layout_marginRight="@dimen/map_fab_margin"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/button_more_settings"
            android:layout_width="@dimen/map_fab_size"
            android:layout_height="@dimen/map_fab_size"
            android:background="@drawable/ripple_background"
            android:clickable="true"
            android:contentDescription="@string/settings"
            android:cropToPadding="false"
            android:elevation="3dp"
            android:onClick="onClickMoreSettings"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/menu_dots_vertical_24"
            app:tint="?attr/colorOnSurface" />

    </LinearLayout>

    <!-- Shown only once a fetch has been running long enough to look like a hang. A tag with
         no key alignment record makes the first fetch search its entire history, which is
         minutes of sequential requests with nothing to show for it on screen. Placed to the
         left of the menu button so the two never overlap.

         Only while some tag has neither a location nor a recent Bluetooth sighting: a tag
         already on screen gains nothing from the wait. See LongFetchBannerState. -->
    <include
        android:id="@+id/long_fetch_banner"
        layout="@layout/long_fetch_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="21dp"
        android:layout_toLeftOf="@id/more_dropdown_top_right"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Anchored above the tag cards. Note that MapsActivity must hide tags_scrollable_area
         with INVISIBLE rather than GONE: RelativeLayout ignores layout_above when its anchor
         is GONE, and with no other vertical rule these buttons would fall back to the top of
         the screen, landing under the status bar. Adding layout_alignParentBottom as a
         fallback does not work either - it is resolved after layout_above and wins, putting
         the buttons behind the cards whenever tags are present. -->
    <LinearLayout
        android:id="@+id/buttons_bottom_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_above="@id/tags_scrollable_area"
        android:layout_alignParentRight="true"
        android:layout_marginRight="@dimen/map_fab_margin"
        android:layout_marginBottom="@dimen/map_fab_to_card_gap"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal">

        <!-- 全部标签：拉起底部的标签列表抽屉。放在这里而不是右上角，是因为它打开的东西
             从底部出来，按钮和结果的动线一致；也让右上角只留设置一项，不与高频操作混在一起。 -->
        <ImageButton
            android:id="@+id/button_tag_list"
            android:layout_width="@dimen/map_fab_size"
            android:layout_height="@dimen/map_fab_size"
            android:layout_marginEnd="@dimen/map_fab_gap"
            android:background="@drawable/ripple_background"
            android:clickable="true"
            android:contentDescription="@string/all_tags"
            android:cropToPadding="false"
            android:elevation="3dp"
            android:focusable="true"
            android:onClick="onClickTagList"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/format_list_bulleted_24px"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/button_navigate_to"
            android:layout_width="@dimen/map_fab_size"
            android:layout_height="@dimen/map_fab_size"
            android:background="@drawable/ripple_background"
            android:clickable="true"
            android:contentDescription="@string/do_navigate"
            android:cropToPadding="false"
            android:elevation="3dp"
            android:focusable="true"
            android:onClick="onClickNavigateTo"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/directions_24px"
            android:visibility="visible"
            app:tint="?attr/colorPrimary" />

        <ImageButton
            android:id="@+id/button_my_location"
            android:layout_width="@dimen/map_fab_size"
            android:layout_height="@dimen/map_fab_size"
            android:layout_marginStart="@dimen/map_fab_gap"
            android:background="@drawable/ripple_background"
            android:clickable="true"
            android:contentDescription="@string/my_location"
            android:cropToPadding="false"
            android:elevation="3dp"
            android:focusable="true"
            android:onClick="onClickMyLocation"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/my_location_24px"
            android:visibility="gone"
            app:tint="?attr/colorPrimary" />

    </LinearLayout>

    <!--
        全部标签抽屉。放在卡片轮播之后、两因素遮罩之前：它展开时要盖住卡片，
        但遇到需要重新验证会话的遮罩必须让位。

        include 上不写 layout_* / id：include 的布局参数会被忽略，用的是被包含布局根节点
        自己的参数（tag_list_sheet.xml 里已经 alignParentBottom），id 也由根节点自己声明，
        重复写一遍反而让 findViewById 和布局里的引用指向两个不同的常量。
    -->
    <include layout="@layout/tag_list_sheet" />

    <!--
        Last child, so it is drawn over everything: with the session in this state nothing on
        this screen can do its job, and a half-covered map invites tapping controls that will
        silently fail. Hidden until a session actually needs a code.
    -->
    <include layout="@layout/two_factor_again_overlay" />

</RelativeLayout>
